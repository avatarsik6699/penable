      "css": ".ds-secondary{font-family:\"Segoe UI\",system-ui,sans-serif;width:100%;min-height:40px;padding:9px 12px;border:0;border-radius:8px;font-size:12px;color:var(--ink,#182230);background:transparent;box-shadow:inset 0 0 0 1px var(--divider,#e0e5ec);cursor:pointer;}.ds-secondary:not(:disabled):hover{background:var(--control-hover,#f1f4f8);}.ds-secondary:focus-visible{outline:2px solid var(--focus,#175cd3);outline-offset:3px;}.ds-secondary:disabled{color:var(--control-disabled,#86909f);cursor:default;}"

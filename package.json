{
  "name": "penable",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:pages": "npm run build -- --base=/penable/",
    "preview": "vite preview",
    "preview:pages": "vite preview --base=/penable/",
    "lint": "oxlint src vite.config.ts --deny-warnings",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "scan:secrets": "gitleaks dir . --config .gitleaks.toml --redact --no-banner",
    "audit:deps": "npm audit --audit-level=moderate"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.93.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
